# ==========================================
# 🐍 Python & Backend Ignored Files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# 📊 Vector Database & Local Data Storage
# ==========================================
# Prevents committing massive database binaries and locks to GitHub
vectordb/
chroma_storage/
*.db
*.sqlite3

# ==========================================
# ⚛️ Frontend & Node Ignored Files
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ==========================================
# 🔑 Security & Local Environment Variables
# ==========================================
# NEVER commit credentials, private keys, or system-specific configurations
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ==========================================
# 💻 Operating System & IDE Specific Files
# ==========================================
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store
Thumbs.db